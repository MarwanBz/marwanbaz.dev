# Site
NEXT_PUBLIC_SITE_URL=https://marwanbaz.dev

# Payload CMS (embedded)
# - DATABASE_URL is auto-injected by the Neon integration on Vercel (vercel env)
# - Run locally with: vercel env pull .env.vercel.local --environment=development
DATABASE_URL=postgres://user:pass@host:5432/db
PAYLOAD_SECRET=generate-with-openssl-rand-base64-32

# Vercel Blob (media uploads, auto-injected by the blob store integration)
BLOB_READ_WRITE_TOKEN=

